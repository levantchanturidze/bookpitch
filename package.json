{
  "name": "bookpitch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "test": "vitest run && npm run test:guards && npm run check:orphan-perms && npm run check:reachable",
    "test:watch": "vitest",
    "test:guards": "tsx scripts/check-guards.ts",
    "check:orphan-perms": "tsx scripts/check-orphan-perms.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "postinstall": "prisma generate",
    "check:reachable": "tsx scripts/check-unreachable-components.ts",
    "verify:sentry": "node scripts/verify-sentry.mjs",
    "e2e:seed": "tsx scripts/seed-e2e-users.ts",
    "e2e:check": "node scripts/check-e2e-coverage.mjs",
    "e2e:all": "npm run e2e:seed && npm run e2e && npm run e2e:check"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@google/genai": "^2.13.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@sentry/nextjs": "^10.67.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.42.2",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.0",
    "stripe": "^22.3.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "js-yaml": "^5.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "browserslist": "^4.28.8",
    "mysql2": "^3.24.2"
  }
}
