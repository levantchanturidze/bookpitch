# Bookpitch — environment variables (P1+ will populate this)
# Copy to `.env.local` and fill in real values. Never commit .env* files.

# ---- Database (P1.1) ----------------------------------------------------------
# Hosted PostgreSQL free tier in an EU region (Frankfurt / eu-central) —
# Neon or Supabase are both fine, we use them purely as Postgres. Data
# residency is a compliance requirement: patient records may not leave the
# EU. See ARCHITECTURE.md §8.
#
# SEC-007 naming: every DB URL variable states BOTH the DB role AND its
# privilege in the variable name itself. Do not wire a superuser URL into a
# slot expecting NOBYPASSRLS — that would defeat the second layer of tenant
# isolation the spec depends on. Legacy names are still accepted as
# fallbacks (see lib/db.ts) for zero-downtime migration; new deployments
# should use the new names.
#
# App connection — Prisma client at runtime. Connects as bookpitch_app,
# which is NOSUPERUSER + NOBYPASSRLS. RLS applies to every query on this
# client and is the enforcer of tenant isolation. On Neon: append
# `?sslmode=require`. On Supabase: use the pooled URL from the dashboard
# ("Transaction" mode, port 6543).
#   Role: bookpitch_app     Privilege: NOBYPASSRLS, NOSUPERUSER
DATABASE_URL_APP_NOBYPASSRLS="postgresql://bookpitch_app:pass@ep-xxxxx.eu-central-1.aws.neon.tech/bookpitch?sslmode=require"
# LEGACY NAME — falls back if _APP_NOBYPASSRLS is unset. Same role/privilege.
DATABASE_URL=""
#
# Read replica — same role as _APP_NOBYPASSRLS, routed to a read-only
# endpoint. Unset = falls back to primary (dev never breaks). Only
# read-only surfaces (analytics, audit-log viewer) use it via
# withOrgReplica(). MUST tolerate replica lag.
#   Role: bookpitch_app     Privilege: NOBYPASSRLS, NOSUPERUSER
DATABASE_URL_APP_REPLICA=""
# LEGACY NAME — falls back if _APP_REPLICA is unset. Same role/privilege.
DATABASE_REPLICA_URL=""
#
# Superuser URL for runtime unsafePrismaAdmin — transaction-pool mode
# (Supabase port 6543, with ?pgbouncer=true&connection_limit=1). BYPASSRLS
# via SUPERUSER. Preferred over the session-pool variant because it
# doesn't consume session-pool slots (F-11 mitigation). Every query on
# this client is a deliberate second-layer waiver — grep for
# `unsafePrismaAdmin` to see the full allowlist, and see SEC-007 for the
# constrained-import ESLint rule.
#   Role: postgres          Privilege: SUPERUSER (implicit BYPASSRLS)
DATABASE_URL_SUPERUSER_TXPOOL=""
# LEGACY NAME — falls back if _SUPERUSER_TXPOOL is unset. Same role/privilege.
ADMIN_RUNTIME_DATABASE_URL=""
#
# Session-pool superuser URL — fallback for unsafePrismaAdmin when the
# tx-pool URL isn't set, AND the URL used by rbac-backfill.ts /
# create-platform-user.ts. On Supabase: port 5432. Consumes one session-
# pool slot per Prisma client.
#   Role: postgres          Privilege: SUPERUSER (implicit BYPASSRLS)
DATABASE_URL_SUPERUSER_SESSION="postgresql://postgres:pass@db.xxxxx.supabase.co:5432/postgres"
# LEGACY NAME — falls back if _SUPERUSER_SESSION is unset. Same role/privilege.
ADMIN_DATABASE_URL=""
#
# Migration superuser URL — used ONLY by .github/workflows/migrate.yml
# for `prisma migrate deploy`. Session pool required for advisory locks.
#   Role: postgres          Privilege: SUPERUSER (implicit BYPASSRLS)
# This is a GH Actions repo secret, not a Vercel env var. Legacy name
# ADMIN_MIGRATE_DATABASE_URL still accepted (see migrate.yml).
# DATABASE_URL_SUPERUSER_MIGRATE — set in GitHub Settings → Secrets
#
# Direct (unpooled) superuser URL — historically used by prisma migrate
# for the auth bypass path. Superseded by DATABASE_URL_SUPERUSER_MIGRATE
# in the GH Actions workflow; kept for local dev convenience.
#   Role: postgres          Privilege: SUPERUSER (implicit BYPASSRLS)
DATABASE_URL_SUPERUSER_DIRECT="postgresql://postgres:pass@db.xxxxx.supabase.co:5432/postgres"
# LEGACY NAME — falls back if _SUPERUSER_DIRECT is unset. Same role/privilege.
DIRECT_URL=""
#
# SEC-007 narrow-role URL — bookpitch_login. Powers ONLY the auth-context
# hot path (lib/rbac/context.ts::buildAuthContext). BYPASSRLS is necessary
# (buildAuthContext runs BEFORE org context is established, so RLS on
# memberships/organizations would filter to zero rows), but the role has
# SELECT grants on only the 8 auth-graph tables. An accidental
# `prismaLogin.customer.findMany()` fails at the Postgres GRANT layer
# with `permission denied for table customers`. Blast radius of the hot
# path shrinks from "every table" to "auth-graph tables."
#   Role: bookpitch_login   Privilege: BYPASSRLS, NOSUPERUSER, narrow SELECT
# Operator setup (after the 20260804000000_bookpitch_login_role migration
# lands): ALTER USER bookpitch_login WITH PASSWORD '...' in Supabase SQL
# editor, then add this URL to Vercel. Until set, prismaLogin transparently
# aliases to unsafePrismaAdmin (no runtime change). No legacy name — this
# is new for SEC-007.
DATABASE_URL_LOGIN=""

# ---- Auth.js (P1.2) ----------------------------------------------------------
# JWT-only sessions; rotate to invalidate every logged-in user.
AUTH_SECRET=""
# Set to true behind a reverse proxy / when NEXT_PUBLIC_URL is not set.
AUTH_TRUST_HOST=true
# Password for the two seeded dev users. Dev-only convenience.
DEV_USER_PASSWORD="devpass123"

# ---- Field-level encryption (P1.4) ------------------------------------------
# 32-byte AES-256-GCM key as hex. Encrypts customers.allergies + clinical_notes
# at rest. Generate one with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=""

# ---- Payments (P2.1) ---------------------------------------------------------
# Which gateway adapter to use. `mock` walks the whole redirect + webhook
# flow locally with no external calls. `bog` / `tbc` hit the real
# Georgian bank APIs and require the matching credentials below.
PAYMENT_GATEWAY="mock"
# HMAC secret for signing/verifying mock-gateway webhooks. Rotate to
# invalidate in-flight mock payments.
PAYMENT_MOCK_SECRET=""
# Absolute origin used to build callback URLs.
APP_URL="http://localhost:3000"
#
# Bank of Georgia iPay (PAYMENT_GATEWAY=bog). Public key is PEM (with
# -----BEGIN PUBLIC KEY-----); newlines can be \n-escaped in .env.
# BOG_CLIENT_ID=""
# BOG_CLIENT_SECRET=""
# BOG_WEBHOOK_PUBLIC_KEY=""
#
# TBC Bank E-Commerce (PAYMENT_GATEWAY=tbc). Webhook secret drives HMAC-SHA256.
# TBC_API_KEY=""
# TBC_CLIENT_ID=""
# TBC_CLIENT_SECRET=""
# TBC_WEBHOOK_SECRET=""

# ---- Reminders (P2.2) --------------------------------------------------------
# Which provider adapter to use. `mock` writes to the server console; real
# ones (smsoffice / postmark) are stubs until API keys land.
SMS_PROVIDER="mock"
EMAIL_PROVIDER="mock"
# SMSOffice.ge (SMS_PROVIDER=smsoffice).
# SMSOFFICE_API_KEY=""
# SMSOFFICE_SENDER=""
# Postmark (EMAIL_PROVIDER=postmark).
# POSTMARK_API_TOKEN=""
# POSTMARK_FROM="no-reply@yourdomain.ge"
# POSTMARK_MESSAGE_STREAM="outbound"
# Bearer secret for POST /api/cron/reminders.
CRON_SECRET=""

# ---- Assistant (P3.5) -------------------------------------------------------
# Which adapter to use. `mock` works fully offline with a regex matcher;
# `gemini` uses @google/genai (gemini-2.5-flash) — needs GOOGLE_API_KEY.
ASSISTANT_MODEL="mock"
GOOGLE_API_KEY=""
# Per-org monthly cap on assistant calls. 0 = disabled. Default 500.
ASSISTANT_MONTHLY_CAP_PER_ORG="500"
# Per-org, per-minute rate limits. 0 = disabled.
ASSISTANT_RPM_PER_ORG="20"
MESSAGING_RPM_PER_ORG="60"

# ---- Observability (T4-D1) --------------------------------------------------
# Server DSN — leave blank locally to silence Sentry entirely.
SENTRY_DSN=""
# Browser DSN. Different from SENTRY_DSN so you can rotate one without the other.
NEXT_PUBLIC_SENTRY_DSN=""
# What Sentry tags the release with — "development" | "staging" | "production".
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"
# Trace sample rates. Lower on edge because middleware fires on every request.
SENTRY_TRACES_SAMPLE_RATE="0.05"
SENTRY_EDGE_TRACES_SAMPLE_RATE="0.01"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"
# Latency budgets — API routes crossing these thresholds get logged at
# warn / error levels so Sentry catches them via level filtering.
LATENCY_WARN_MS="1000"
LATENCY_ERROR_MS="3000"

# ---- Privacy / GDPR (T4-D3) -------------------------------------------------
# Days the operator has to fulfill a DSR. GDPR statutory default is 30.
# Rows on /settings/privacy older than this get an "overdue" badge.
DSR_DEADLINE_DAYS="30"

# ---- Web Push (T4-C1) -------------------------------------------------------
# Generate keys with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""      # same as VAPID_PUBLIC_KEY, exposed to browser
VAPID_SUBJECT="mailto:ops@bookpitch.ge"

# ---- SaaS billing (T4-B1) ---------------------------------------------------
# Stripe Secret + Publishable + webhook signing secret.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Product price IDs for the Pro / Clinic subscriptions.
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_CLINIC=""
