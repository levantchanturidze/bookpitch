# Bookpitch — environment variables (P1+ will populate this)
# Copy to `.env.local` and fill in real values. Never commit .env* files.

# ---- Database (P1.1) ----------------------------------------------------------
# Hosted PostgreSQL free tier in an EU region (Frankfurt / eu-central) —
# Neon or Supabase are both fine, we use them purely as Postgres. Data
# residency is a compliance requirement: patient records may not leave the
# EU. See ARCHITECTURE.md §8.
#
# App connection — Prisma client at runtime. Connects as a NON-OWNER role
# (RLS applies). On Neon: append `?sslmode=require`. On Supabase: use the
# pooled URL from the dashboard ("Transaction" mode, port 6543).
DATABASE_URL="postgresql://bookpitch_app:pass@ep-xxxxx.eu-central-1.aws.neon.tech/bookpitch?sslmode=require"
# Direct (unpooled) connection used by `prisma migrate` and the auth
# bypass path. On Neon: the "direct" URL. On Supabase: port 5432.
DIRECT_URL="postgresql://postgres:pass@db.xxxxx.supabase.co:5432/postgres"
# Admin URL used by lib/db.ts::prismaAdmin (auth lookup + system tasks).
# Superuser / BYPASSRLS capable. Same as DIRECT_URL on Neon.
ADMIN_DATABASE_URL="postgresql://postgres:pass@db.xxxxx.supabase.co:5432/postgres"

# ---- Auth.js (P1.2) ----------------------------------------------------------
# JWT-only sessions; rotate to invalidate every logged-in user.
AUTH_SECRET=""
# Set to true behind a reverse proxy / when NEXT_PUBLIC_URL is not set.
AUTH_TRUST_HOST=true
# Password for the two seeded dev users. Dev-only convenience.
DEV_USER_PASSWORD="devpass123"

# ---- Field-level encryption (P1.4) ------------------------------------------
# 32-byte AES-256-GCM key as hex. Encrypts customers.allergies + clinical_notes
# at rest. Generate one with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=""

# ---- Payments (P2.1) ---------------------------------------------------------
# Which gateway adapter to use. `mock` walks the whole redirect + webhook
# flow locally with no external calls. `bog` / `tbc` are stubs until real
# merchant credentials are provided.
PAYMENT_GATEWAY="mock"
# HMAC secret for signing/verifying mock-gateway webhooks. Rotate to
# invalidate in-flight mock payments.
PAYMENT_MOCK_SECRET=""
# Absolute origin used to build callback URLs.
APP_URL="http://localhost:3000"
# Real gateway credentials (fill when swapping in BoG / TBC):
# PAYMENT_MERCHANT_ID=""
# PAYMENT_API_KEY=""
# PAYMENT_WEBHOOK_SECRET=""

# ---- Reminders (P2.2) --------------------------------------------------------
# Which provider adapter to use. `mock` writes to the server console; real
# ones (smsoffice / postmark) are stubs until API keys land.
SMS_PROVIDER="mock"
EMAIL_PROVIDER="mock"
# Real provider credentials — fill when swapping in.
# SMS_API_KEY=""
# SMS_SENDER_ID=""
# EMAIL_API_KEY=""
# EMAIL_FROM="reminders@yourdomain.com"
# Bearer secret for POST /api/cron/reminders.
CRON_SECRET=""

# ---- Assistant (P3.5) -------------------------------------------------------
# Which adapter to use. `mock` works fully offline with a regex matcher;
# `gemini` uses @google/genai (gemini-2.5-flash) — needs GOOGLE_API_KEY.
ASSISTANT_MODEL="mock"
GOOGLE_API_KEY=""
