# Bookpitch — environment variables (P1+ will populate this)
# Copy to `.env.local` and fill in real values. Never commit .env* files.

# ---- Database (P1.1) ----------------------------------------------------------
# DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"

# ---- Supabase auth + storage (P1.2) ------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# ---- Payments (P2.1) — BoG iPay or TBC E-Commerce ---------------------------
# PAYMENT_GATEWAY=""            # "bog_ipay" | "tbc_ecommerce"
# PAYMENT_MERCHANT_ID=""
# PAYMENT_API_KEY=""
# PAYMENT_WEBHOOK_SECRET=""

# ---- Reminders (P2.2) --------------------------------------------------------
# SMS_PROVIDER_API_KEY=""
# EMAIL_PROVIDER_API_KEY=""
