# Bookpitch — environment variables (P1+ will populate this)
# Copy to `.env.local` and fill in real values. Never commit .env* files.

# ---- Database (P1.1) ----------------------------------------------------------
# Pooled connection used by the Prisma client at runtime.
DATABASE_URL="postgresql://user:pass@host:5432/bookpitch_dev?schema=public"
# Direct (unpooled) connection used by `prisma migrate`. Same as DATABASE_URL
# for local Postgres; on Supabase these differ (pgbouncer 6543 vs. 5432).
DIRECT_URL="postgresql://user:pass@host:5432/bookpitch_dev?schema=public"

# ---- Auth.js (P1.2) ----------------------------------------------------------
# JWT-only sessions; rotate to invalidate every logged-in user.
AUTH_SECRET=""
# Set to true behind a reverse proxy / when NEXT_PUBLIC_URL is not set.
AUTH_TRUST_HOST=true
# Password for the two seeded dev users. Dev-only convenience.
DEV_USER_PASSWORD="devpass123"

# ---- Payments (P2.1) — BoG iPay or TBC E-Commerce ---------------------------
# PAYMENT_GATEWAY=""            # "bog_ipay" | "tbc_ecommerce"
# PAYMENT_MERCHANT_ID=""
# PAYMENT_API_KEY=""
# PAYMENT_WEBHOOK_SECRET=""

# ---- Reminders (P2.2) --------------------------------------------------------
# SMS_PROVIDER_API_KEY=""
# EMAIL_PROVIDER_API_KEY=""
