// Bookpitch — Prisma schema
// 1:1 translation of schema.sql (production Postgres schema).
// Raw SQL for GiST exclusion, triggers, and RLS lives in the migrations
// folder because Prisma cannot express them.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgcrypto, btree_gist, citext]
}

// =============================================================================
// ENUMS
// =============================================================================

enum LocationType {
  clinic
  salon

  @@map("location_type")
}

enum UserRole {
  owner
  practitioner
  receptionist

  @@map("user_role")
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled

  @@map("appointment_status")
}

enum PaymentStatus {
  unpaid
  paid
  refunding
  refunded

  @@map("payment_status")
}

enum PaymentMethod {
  card
  apple_pay
  google_pay
  cash

  @@map("payment_method")
}

enum MessageChannel {
  sms
  email

  @@map("message_channel")
}

enum MessageState {
  queued
  sent
  failed
  delivered

  @@map("message_state")
}

// =============================================================================
// TENANCY
// =============================================================================

model Organization {
  id                     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String
  reminderLeadHours      Int    @default(24) @map("reminder_lead_hours") @db.SmallInt
  customerRetentionYears Int    @default(7) @map("customer_retention_years") @db.SmallInt

  // SaaS subscription — see billing migration + lib/billing/*.
  plan                 String    @default("free")
  planStatus           String    @default("active") @map("plan_status")
  stripeCustomerId     String?   @unique(map: "idx_org_stripe_customer") @map("stripe_customer_id")
  stripeSubscriptionId String?   @unique(map: "idx_org_stripe_subscription") @map("stripe_subscription_id")
  currentPeriodEnd     DateTime? @map("current_period_end") @db.Timestamptz(6)

  // Feature flags — see lib/features.ts. JSONB so new flags land in
  // code, not migrations. Absent key = disabled.
  features Json @default("{}") @db.JsonB

  // ISO 4217 currency code for all payments in this org. Default GEL; change
  // when multi-currency support lands.
  currency String @default("GEL") @db.VarChar(3) @map("currency")

  // ---- Spec §3 additions (RBAC Phase 1). Backfill in Phase 2.
  vertical                  String? // clinic|salon|fitness|mixed — CHECK in migration
  legalName                 String? @map("legal_name")
  brandName                 String? @map("brand_name")
  status                    String  @default("active") // pending_setup|trial|active|suspended|archived
  ownerUserId               String? @map("owner_user_id") @db.Uuid
  allowSupportImpersonation Boolean @default(false) @map("allow_support_impersonation")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  locations             Location[]
  branches              Branch[]
  memberships           Membership[]
  staff                 Staff[]
  services              Service[]
  customers             Customer[]
  appointments          Appointment[]
  payments              Payment[]
  messageTemplates      MessageTemplate[]
  messageLog            MessageLog[]
  notifications         Notification[]
  auditLog              AuditLog[]
  assistantUsage        AssistantUsage[]
  rateLimits            RateLimit[]
  invitations           Invitation[]
  waitlist              Waitlist[]
  customRoles           Role[]
  ownerUser             AppUser?               @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  impersonationSessions ImpersonationSession[]
  breakGlassSessions    BreakGlassSession[]
  ownershipTransfers    OwnershipTransfer[]
  reauthGrants          PlatformReauthGrant[]  @relation("OrgReauthGrants")

  @@index([status], map: "idx_org_status")
  @@index([ownerUserId], map: "idx_org_owner_user_id")
  @@map("organizations")
}

model Location {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           LocationType
  name           String
  timezone       String       @default("Asia/Tbilisi")
  taxRate        Decimal      @default(0) @map("tax_rate") @db.Decimal(5, 4)
  // Public booking widget: null = disabled; when set, /book/<publicSlug>
  // renders the customer-facing booking page for this location.
  publicSlug     String?      @unique(map: "idx_locations_public_slug") @map("public_slug")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staff        Staff[]
  services     Service[]
  appointments Appointment[]
  waitlists    Waitlist[]    @relation("WaitlistLocation")
  // Reverse of Branch.legacyLocation — Phase 2 sets one Branch per Location.
  branch       Branch?       @relation("BranchLegacyLocation")

  @@index([organizationId], map: "idx_locations_org")
  @@map("locations")
}

// =============================================================================
// IDENTITY & ACCESS
// =============================================================================

model AppUser {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authProvider   String    @map("auth_provider")
  authSubject    String    @map("auth_subject")
  email          String    @unique @db.Citext
  fullName       String?   @map("full_name")
  // Auth.js Prisma adapter surface: name / emailVerified / image.
  // `name` mirrors fullName; the adapter writes it directly on user upsert.
  name           String?
  emailVerified  DateTime? @map("email_verified") @db.Timestamptz(6)
  image          String?
  // Set only when authProvider = 'credentials'; null for future SSO users.
  passwordHash   String?   @map("password_hash")
  // Bumped on password reset / admin revocation. JWTs carrying an older
  // value are rejected by the session() callback in auth.ts.
  sessionVersion Int       @default(1) @map("session_version")

  // ---- Spec §3 additions (RBAC Phase 1).
  status            String    @default("active") // active|locked|deleted (CHECK in migration)
  locale            String?
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  // AES-GCM encrypted TOTP secret (same scheme as allergies/clinicalNotes).
  // NULL = MFA not enrolled; non-null = TOTP required for break-glass.
  mfaTotp           String?   @map("mfa_totp")
  // Pending TOTP secret during re-enrollment. Written by generateTotpEnrollment
  // when mfaEnabled=true; promoted to mfaTotp (and cleared) by confirmTotpEnrollment.
  // verifyTotp always reads mfaTotp so the active break-glass path is unaffected.
  mfaTotpPending          String?   @map("mfa_totp_pending")
  // Timestamp when mfaTotpPending was written, for housekeeping to sweep stale challenges.
  mfaTotpPendingCreatedAt DateTime? @map("mfa_totp_pending_created_at") @db.Timestamptz(6)
  // Unix epoch of the last successfully consumed TOTP 30s window, for replay protection.
  mfaLastTotpWindow BigInt?   @map("mfa_last_totp_window")
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  // Platform-plane role (SUPER_ADMIN, PLATFORM_ADMIN, …). NULL for
  // org-plane-only users — that is, everyone today.
  platformRoleId    String?   @map("platform_role_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships                  Membership[]
  staffProfiles                Staff[]
  appointments                 Appointment[]
  auditLog                     AuditLog[]             @relation("AuditActor")
  auditLogOnBehalfOf           AuditLog[]             @relation("AuditOnBehalfOf")
  pushSubscriptions            PushSubscription[]
  platformRole                 Role?                  @relation("UserPlatformRole", fields: [platformRoleId], references: [id], onDelete: SetNull)
  ownedOrganizations           Organization[]         @relation("OrganizationOwner")
  invitationsSent              Membership[]           @relation("MembershipInviter")
  impersonationSessionsStarted ImpersonationSession[] @relation("ImpersonationActor")
  impersonationSessionsTarget  ImpersonationSession[] @relation("ImpersonationTarget")
  breakGlassSessions           BreakGlassSession[]
  ownershipTransfersInitiated  OwnershipTransfer[]    @relation("OwnershipTransferFrom")
  ownershipTransfersReceived   OwnershipTransfer[]    @relation("OwnershipTransferTo")
  platformReauthGrants         PlatformReauthGrant[]
  recoveryCode                 AppUserRecoveryCode[]
  issuedInvitations            Invitation[]           @relation("InvitationInvitedBy")

  @@unique([authProvider, authSubject])
  @@index([status], map: "idx_app_users_status")
  @@index([platformRoleId], map: "idx_app_users_platform_role")
  @@map("app_users")
}

// Auth.js verification-token store. Powers password reset + magic-link
// flows. Rows are short-lived: the adapter creates them on request and
// deletes them on verify.
model PushSubscription {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  endpoint   String   @unique(map: "push_subscription_endpoint_unique")
  p256dh     String
  auth       String
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "push_subscription_user_fk")

  @@index([userId], map: "idx_push_subscription_user")
  @@map("push_subscription")
}

model VerificationToken {
  identifier String
  token      String   @id
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Membership {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  // Legacy enum column. Kept alive through Phase 4; contracted much later.
  role           UserRole
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // ---- Spec §3 additions (RBAC Phase 1). role_id backfilled in Phase 2.
  roleId          String?   @map("role_id") @db.Uuid
  status          String    @default("active") // invited|active|suspended|removed
  isBookable      Boolean   @default(false) @map("is_bookable")
  invitedByUserId String?   @map("invited_by_user_id") @db.Uuid
  joinedAt        DateTime? @map("joined_at") @db.Timestamptz(6)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         AppUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleRef      Role?              @relation("MembershipRole", fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    AppUser?           @relation("MembershipInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  branches     MembershipBranch[]

  // Existing invariant (one enum-role per user per org). Kept until Contract.
  @@unique([organizationId, userId])
  @@index([userId], map: "idx_memberships_user")
  @@index([organizationId, status], map: "idx_memberships_org_status")
  // Future canonical uniqueness — partial (only enforces once role_id is
  // backfilled), so it does not collide with the legacy unique above.
  // Prisma cannot express partial unique indexes; the DB migration
  // (20260727160000_rbac_memberships_columns) creates it directly.
  @@map("memberships")
}

// =============================================================================
// STAFF
// =============================================================================

model Staff {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  locationId     String   @map("location_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  name           String
  roleTitle      String   @map("role_title")
  specialty      String?
  email          String?  @db.Citext
  phone          String?
  avatarUrl      String?  @map("avatar_url")
  calendarColor  String?  @map("calendar_color")
  rating         Decimal? @db.Decimal(3, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  user         AppUser?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  availability StaffAvailability[]
  appointments Appointment[]
  waitlists    Waitlist[]          @relation("WaitlistStaff")

  @@index([locationId], map: "idx_staff_location")
  @@map("staff")
}

model StaffAvailability {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  weekday   Int      @db.SmallInt
  startTime DateTime @map("start_time") @db.Time(6)
  endTime   DateTime @map("end_time") @db.Time(6)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId], map: "idx_availability_staff")
  @@map("staff_availability")
}

// =============================================================================
// SERVICE CATALOG
// =============================================================================

model Service {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  name            String
  category        String?
  price           Decimal  @db.Decimal(10, 2)
  durationMinutes Int      @map("duration_minutes")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  waitlists    Waitlist[]    @relation("WaitlistService")

  @@index([locationId], map: "idx_services_location")
  @@map("services")
}

// =============================================================================
// CUSTOMERS (patients / clients) — CONTAINS SENSITIVE HEALTH DATA
// =============================================================================

model Customer {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  name                  String
  email                 String?   @db.Citext
  phone                 String?
  dob                   DateTime? @db.Date
  gender                String?
  avatarUrl             String?   @map("avatar_url")
  joinedDate            DateTime  @default(dbgenerated("CURRENT_DATE")) @map("joined_date") @db.Date
  // Sensitive (health) fields — encryption + audit added in P1.4
  allergies             String?
  clinicalNotes         String?   @map("clinical_notes")
  consentAt             DateTime? @map("consent_at") @db.Timestamptz(6)
  consentVersion        String?   @map("consent_version")
  // Insurance carrier + policy number for claim exports. Nullable —
  // patients without insurance leave both empty.
  insurerName           String?   @map("insurer_name")
  insurancePolicyNumber String?   @map("insurance_policy_number")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  treatmentHistory TreatmentHistory[]
  appointments     Appointment[]
  waitlists        Waitlist[]         @relation("WaitlistCustomer")

  @@index([organizationId], map: "idx_customers_org")
  @@index([organizationId, insurerName], map: "idx_customers_org_insurer")
  @@map("customers")
}

model TreatmentHistory {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  label      String
  occurredOn DateTime? @map("occurred_on") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId], map: "idx_history_customer")
  @@map("treatment_history")
}

// =============================================================================
// APPOINTMENTS (booking core)
// =============================================================================

model Appointment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  locationId       String            @map("location_id") @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  staffId          String            @map("staff_id") @db.Uuid
  serviceId        String?           @map("service_id") @db.Uuid
  startsAt         DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime          @map("ends_at") @db.Timestamptz(6)
  serviceName      String            @map("service_name")
  price            Decimal           @db.Decimal(10, 2)
  status           AppointmentStatus @default(pending)
  paymentStatus    PaymentStatus     @default(unpaid) @map("payment_status")
  notes            String?
  // Insurance / claim export support — see lib/insurance.ts.
  // Both nullable: not every visit is billable to an insurer.
  icd10Code        String?           @map("icd10_code")
  icd10Description String?           @map("icd10_description")
  createdBy        String?           @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  creator      AppUser?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  payments     Payment[]
  messageLog   MessageLog[]

  @@index([locationId, startsAt], map: "idx_appt_location_day")
  @@index([staffId, startsAt], map: "idx_appt_staff")
  @@index([customerId], map: "idx_appt_customer")
  @@map("appointments")
}

// =============================================================================
// PAYMENTS
// =============================================================================

model Payment {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  appointmentId  String?       @map("appointment_id") @db.Uuid
  method         PaymentMethod
  gateway        String?
  gatewayTxnId   String?       @map("gateway_txn_id")
  amount         Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @default(0) @map("tax_amount") @db.Decimal(10, 2)
  currency       String        @default("GEL")
  status         PaymentStatus @default(unpaid)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([appointmentId], map: "idx_payments_appt")
  @@map("payments")
}

// =============================================================================
// MESSAGING & NOTIFICATIONS
// =============================================================================

model MessageTemplate {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  channel        MessageChannel
  body           String
  updatedAt      DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("message_templates")
}

model MessageLog {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  appointmentId  String?        @map("appointment_id") @db.Uuid
  channel        MessageChannel
  toAddress      String         @map("to_address")
  body           String
  providerMsgId  String?        @map("provider_msg_id")
  state          MessageState   @default(queued)
  scheduledFor   DateTime?      @map("scheduled_for") @db.Timestamptz(6)
  sentAt         DateTime?      @map("sent_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment  Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  // NOTE: partial index `WHERE state = 'queued'` added via raw SQL in migration.
  @@index([appointmentId, channel, state], map: "idx_message_log_appt_channel_state")
  @@map("message_log")
}

model Notification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  title          String
  body           String?
  type           String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)], map: "idx_notifications_org")
  @@map("notifications")
}

// =============================================================================
// ASSISTANT USAGE — per-org monthly LLM call counter
// =============================================================================

model AssistantUsage {
  organizationId String   @map("organization_id") @db.Uuid
  yearMonth      Int      @map("year_month")
  count          Int      @default(0)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "assistant_usage_org_fk")

  @@id([organizationId, yearMonth])
  @@map("assistant_usage")
}

model Waitlist {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  locationId     String?   @map("location_id") @db.Uuid
  staffId        String?   @map("staff_id") @db.Uuid
  serviceId      String?   @map("service_id") @db.Uuid
  preferredFrom  DateTime  @map("preferred_from") @db.Timestamptz(6)
  preferredTo    DateTime  @map("preferred_to") @db.Timestamptz(6)
  status         String    @default("pending")
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  notifiedAt     DateTime? @map("notified_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "waitlist_org_fk")
  customer     Customer     @relation("WaitlistCustomer", fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "waitlist_customer_fk")
  location     Location?    @relation("WaitlistLocation", fields: [locationId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "waitlist_location_fk")
  staff        Staff?       @relation("WaitlistStaff", fields: [staffId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "waitlist_staff_fk")
  service      Service?     @relation("WaitlistService", fields: [serviceId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "waitlist_service_fk")

  @@index([organizationId, status], map: "idx_waitlist_org_status")
  @@index([organizationId, status, preferredFrom, preferredTo], map: "idx_waitlist_matcher")
  @@map("waitlist")
}

model Invitation {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.Citext
  role           UserRole
  tokenHash      String    @unique(map: "invitations_token_unique") @map("token_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  status         String    @default("pending")
  invitedBy      String?   @map("invited_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "invitations_org_fk")
  invitedByUser AppUser?     @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "invitations_invited_by_fk")

  @@index([organizationId, status], map: "idx_invitations_org_status")
  @@map("invitations")
}

model RateLimit {
  organizationId String   @map("organization_id") @db.Uuid
  bucket         String
  windowStart    DateTime @map("window_start") @db.Timestamptz(0)
  count          Int      @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "rate_limit_org_fk")

  @@id([organizationId, bucket, windowStart])
  @@index([windowStart], map: "idx_rate_limit_window")
  @@map("rate_limit")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

model AuditLog {
  id             BigInt   @default(autoincrement())
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String
  entity         String
  entityId       String?  @map("entity_id") @db.Uuid
  at             DateTime @default(now()) @db.Timestamptz(6)
  ip             String?  @db.Inet
  meta           Json?

  // ---- Spec §7.1 additions (RBAC Phase 1). Populated by Phase 5.
  onBehalfOfUserId       String? @map("on_behalf_of_user_id") @db.Uuid
  userAgent              String? @map("user_agent")
  reason                 String?
  impersonationSessionId String? @map("impersonation_session_id") @db.Uuid
  breakGlassSessionId    String? @map("break_glass_session_id") @db.Uuid

  // ON DELETE NO ACTION — migration 20260727180000_audit_log_fk_hardening
  // intentionally prevents deleting orgs/users with audit history.
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: NoAction)
  actor        AppUser?      @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: NoAction)
  onBehalfOf   AppUser?      @relation("AuditOnBehalfOf", fields: [onBehalfOfUserId], references: [id], onDelete: NoAction)

  // Composite PK — Postgres declarative partitioning requires the
  // partition key (`at`) to be included in every unique constraint.
  // The id sequence still guarantees per-row uniqueness in practice.
  //
  // APPEND-ONLY: UPDATE and DELETE are blocked at the DB level (trigger +
  // revoked grants). See 20260727170000_rbac_audit_log_append_only. Do
  // not add Prisma methods that would call .update() or .delete() on
  // this model — they will always raise at runtime.
  @@id([at, id])
  @@index([entity, entityId], map: "idx_audit_entity")
  @@index([actorUserId, at(sort: Desc)], map: "idx_audit_actor")
  @@index([at(sort: Desc)], map: "idx_audit_at")
  @@index([organizationId, at(sort: Desc)], map: "idx_audit_org_at")
  @@map("audit_log")
}

// =============================================================================
// RBAC (spec §3) — permissions live in the database.
// =============================================================================

model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String
  displayName    String   @map("display_name")
  plane          String // platform | organization | consumer (CHECK in migration)
  rank           Int
  // NULL = system template. When set, this is a custom role owned by an
  // organization (Phase 6 feature). Two partial unique indexes in the
  // migration enforce (key) globally for system rows and (org_id, key)
  // for custom rows — Prisma cannot express partial uniques, so they
  // live in SQL only.
  organizationId String?  @map("organization_id") @db.Uuid
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization      Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions       RolePermission[]
  memberships       Membership[]     @relation("MembershipRole")
  platformRoleUsers AppUser[]        @relation("UserPlatformRole")
  // Phase 3 lattice edges. `canManage` = roles this role can manage;
  // `managedBy` = roles that can manage this one. See lib/rbac/rank.ts.
  canManage         RoleCanManage[]  @relation("RoleCanManage_Parent")
  managedBy         RoleCanManage[]  @relation("RoleCanManage_Child")

  @@index([plane], map: "idx_roles_plane")
  @@map("roles")
}

// Phase 3: role management lattice. Numeric rank alone can't distinguish
// FRONT_DESK and PROVIDER (both rank 40); this table is the explicit
// adjacency list that lib/rbac/rank.ts::canManageRoleAssignment combines
// with the rank check.
model RoleCanManage {
  parentRoleId String   @map("parent_role_id") @db.Uuid
  childRoleId  String   @map("child_role_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent Role @relation("RoleCanManage_Parent", fields: [parentRoleId], references: [id], onDelete: Cascade, map: "role_can_manage_parent_fkey")
  child  Role @relation("RoleCanManage_Child", fields: [childRoleId], references: [id], onDelete: Cascade, map: "role_can_manage_child_fkey")

  @@id([parentRoleId, childRoleId])
  @@index([parentRoleId], map: "idx_role_can_manage_parent")
  @@map("role_can_manage")
}

model Permission {
  key         String   @id
  resource    String
  action      String
  scope       String? // own|branch|org|platform|limited|unlimited|any|basic|contact|full
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@index([resource], map: "idx_permissions_resource")
  @@map("permissions")
}

model RolePermission {
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
  @@index([permissionKey], map: "idx_role_permissions_permission")
  @@map("role_permissions")
}

// Branch = future replacement for Location (Phase 2 backfills 1:1).
// EXPAND: coexists with Location until Contract, months later.
model Branch {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  name             String
  address          String?
  timezone         String   @default("Asia/Tbilisi")
  status           String   @default("active") // active|inactive (CHECK)
  // Back-pointer to the Location this branch was migrated from. Set
  // during Phase 2; NULL for branches created after Contract.
  legacyLocationId String?  @unique(map: "branches_legacy_location_id_unique") @map("legacy_location_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legacyLocation Location?          @relation("BranchLegacyLocation", fields: [legacyLocationId], references: [id], onDelete: SetNull)
  memberships    MembershipBranch[]

  @@index([organizationId], map: "idx_branches_org")
  @@map("branches")
}

model MembershipBranch {
  membershipId String   @map("membership_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([branchId], map: "idx_membership_branches_branch")
  @@map("membership_branches")
}

// =============================================================================
// PLATFORM SESSIONS (Phase 5 — spec §7.1 impersonation, §7.2 break-glass)
// =============================================================================

// Time-bounded impersonation session. Actor is a platform-plane user
// (PLATFORM_ADMIN typically); onBehalfOf is the org-plane user whose
// account the actor is inside. Populated into ctx.impersonation by
// lib/rbac/context.ts on every request.
model ImpersonationSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId      String    @map("actor_user_id") @db.Uuid
  onBehalfOfUserId String    @map("on_behalf_of_user_id") @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  reason           String
  ticketId         String    @map("ticket_id")
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  endedAt          DateTime? @map("ended_at") @db.Timestamptz(6)
  endedReason      String?   @map("ended_reason")
  ip               String?   @db.Inet
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  actor        AppUser      @relation("ImpersonationActor", fields: [actorUserId], references: [id], onDelete: NoAction, map: "impersonation_sessions_actor_fkey")
  onBehalfOf   AppUser      @relation("ImpersonationTarget", fields: [onBehalfOfUserId], references: [id], onDelete: NoAction, map: "impersonation_sessions_on_behalf_of_fkey")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, map: "impersonation_sessions_org_fkey")

  // idx_impersonation_sessions_actor_active is a partial index
  // (WHERE ended_at IS NULL) declared in the migration; Prisma can't
  // express partial indexes.
  @@index([organizationId, startedAt], map: "idx_impersonation_sessions_org")
  @@map("impersonation_sessions")
}

// SUPER_ADMIN-only break-glass session (spec §7.2). Password re-auth
// required to start; every read during the window is audited with
// break_glass_session_id.
model BreakGlassSession {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId          String    @map("actor_user_id") @db.Uuid
  targetOrganizationId String?   @map("target_organization_id") @db.Uuid
  reason               String
  ticketId             String    @map("ticket_id")
  startedAt            DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz(6)
  endedAt              DateTime? @map("ended_at") @db.Timestamptz(6)
  endedReason          String?   @map("ended_reason")
  ip                   String?   @db.Inet
  userAgent            String?   @map("user_agent")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  actor        AppUser       @relation(fields: [actorUserId], references: [id], onDelete: NoAction, map: "break_glass_sessions_actor_fkey")
  organization Organization? @relation(fields: [targetOrganizationId], references: [id], onDelete: NoAction, map: "break_glass_sessions_org_fkey")

  @@map("break_glass_sessions")
}

// Two-step ownership transfer (Phase 6, spec §4.2 + §9 rule 1). One
// pending transfer per org enforced by a partial unique index (see
// migration). Rows persist post-decision as history — same "sessions
// outlive actors" argument as ImpersonationSession.
model OwnershipTransfer {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  fromUserId     String    @map("from_user_id") @db.Uuid
  toUserId       String    @map("to_user_id") @db.Uuid
  status         String    @default("pending")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedReason  String?   @map("decided_reason")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, map: "ownership_transfers_org_fkey")
  fromUser     AppUser      @relation("OwnershipTransferFrom", fields: [fromUserId], references: [id], onDelete: NoAction, map: "ownership_transfers_from_fkey")
  toUser       AppUser      @relation("OwnershipTransferTo", fields: [toUserId], references: [id], onDelete: NoAction, map: "ownership_transfers_to_fkey")

  @@map("ownership_transfers")
}

// Global (non-tenant) rate-limit buckets for platform-plane operations:
// onboard abuse protection (bucket = "onboard:ip:<ip>") and platform
// reauth brute-force protection (bucket = "reauth:<userId>").
// Rows older than the window are swept by the housekeeping cron.
model PlatformRateLimit {
  bucket      String   @map("bucket")
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)

  @@id([bucket, windowStart])
  @@index([windowStart], map: "idx_platform_rate_limit_window")
  @@map("platform_rate_limit")
}

// Session/purpose/org-bound, single-use reauthentication grant.
// Created by verifyPasswordFresh; atomically consumed by requireFreshPassword.
// One unconsumed grant per (userId, authSessionId, purpose) enforced by
// the partial unique index idx_reauth_grant_active (WHERE consumed_at IS NULL).
// Consumed grants are retained for audit history; housekeeping sweeps
// expired/consumed rows after 24 hours.
model PlatformReauthGrant {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  // Stable JWT claim identifying the specific login session that verified the
  // password. Ensures session A cannot consume a grant created by session B.
  authSessionId  String    @map("auth_session_id")
  // Allowlisted action this grant authorises. See lib/platform/reauth-purpose.ts.
  purpose        String    @map("purpose")
  // Target organization for org-scoped operations (suspend, delete). Null for
  // platform-wide operations (MFA enroll/confirm, break-glass start).
  orgId          String?   @map("org_id") @db.Uuid
  grantedAt      DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  sessionVersion Int       @default(0) @map("session_version")
  // Set atomically by requireFreshPassword. Non-null = already consumed.
  consumedAt     DateTime? @map("consumed_at") @db.Timestamptz(6)

  user AppUser       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  org  Organization? @relation("OrgReauthGrants", fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  // idx_reauth_grant_active: UNIQUE PARTIAL (WHERE consumed_at IS NULL) declared
  // in migration 20260806000003. Prisma cannot express partial/conditional indexes
  // so it is omitted here to avoid perpetual schema drift in migrate diff.
  @@index([expiresAt], map: "idx_reauth_grant_expires")
  @@map("platform_reauth_grant")
}

// Pending self-service registration. Created by POST /api/onboard;
// activated (converted to real org + user) by GET /api/onboard/verify?token=.
// Rows expire after 24 hours. Housekeeping sweep removes expired rows.
model PendingRegistration {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  orgName      String   @map("org_name")
  locationName String   @default("Main location") @map("location_name")
  locationType String   @default("clinic") @map("location_type")
  // SHA-256 hash of the random 32-byte verification token. The raw token is
  // sent by email and never stored. Hash is sufficient because the token is
  // uniformly random (brute-force infeasible).
  tokenHash    String   @map("token_hash")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tokenHash], map: "idx_pending_reg_token")
  @@index([expiresAt], map: "idx_pending_reg_expires")
  @@map("pending_registrations")
}

// Transactional email outbox.
//
// Written inside the same DB transaction as the event that triggers the email
// (e.g. break-glass session start). The housekeeping cron drains pending rows.
// This ensures:
//   • Emails are not sent for events that roll back.
//   • Email send failures do not silently swallow security alerts.
//   • Each row is retried up to maxAttempts before being marked failed.
//
// Purpose tokens:
//   break_glass.alert   — security alert sent to SECURITY_ALERT_EMAIL
//   impersonation.notify — org-owner notification on impersonation start
model EmailOutbox {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Caller-supplied idempotency key (e.g. 'break_glass_alert:{sessionId}').
  // Enforced UNIQUE via sparse DB index (migration 20260813000005).
  // Prisma cannot express partial unique indexes — DB enforcement only.
  idempotencyKey String?   @map("idempotency_key")
  toAddress      String    @map("to_address")
  subject        String
  body           String
  purpose        String
  // State machine: pending → processing → sent | dead
  status         String    @default("pending")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Exponential-backoff scheduling for retries. Set to now() initially.
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  failedAt       DateTime? @map("failed_at") @db.Timestamptz(6)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  lastError      String?   @map("last_error")
  failureCategory String?  @map("failure_category")
  // Concurrent-worker claiming (FOR UPDATE SKIP LOCKED in migration 20260813000005).
  claimOwner     String?   @map("claim_owner")
  claimExpiresAt DateTime? @map("claim_expires_at") @db.Timestamptz(6)
  claimedAt      DateTime? @map("claimed_at") @db.Timestamptz(6)
  // When true, body contains AES-256-GCM ciphertext from encryptField().
  // Drain decrypts before passing to the email provider.
  bodyEncrypted       Boolean  @default(false) @map("body_encrypted")
  // When true, to_address contains AES-256-GCM ciphertext (encryptField).
  // to_address_hash stores SHA-256 hex of the lowercase plaintext for filtering.
  toAddressEncrypted  Boolean  @default(false) @map("to_address_encrypted")
  toAddressHash       String?  @map("to_address_hash")

  // idx_email_outbox_worker (WHERE status = 'pending') — partial, migration only.
  // idx_email_outbox_to_address_hash — partial index on non-null hash, migration only.
  @@index([createdAt], map: "idx_email_outbox_created")
  @@map("email_outbox")
}

// Single-use backup codes for TOTP recovery. Generated in batches of 8;
// stored as SHA-256 hashes (codes are random, so SHA-256 is sufficient).
// Consumption atomically marks used_at; rate-limited via platform_rate_limit.
model AppUserRecoveryCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user AppUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "idx_recovery_codes_user_unused")
  @@map("app_user_recovery_codes")
}
