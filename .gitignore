# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code session state
.claude/

# ------ SEC-007 hardening — block workspace clutter that keeps landing at
# root and is one careless `git add -A` from being committed. Anything that
# plausibly holds a secret (Word docs from Supabase, shell scripts under
# scripts/, .zip bundles, screenshot folders) is on this list. Add
# exceptions as new legitimate files land.
Supabase*.docx
*.docx
*.zip
old/
untitled\ folder/
# rotation scripts do not live in the repo (CLAUDE.md F-12) — block .sh
# under scripts/ but re-include the maintained tsx/js tooling
scripts/*.sh
!scripts/*.ts
!scripts/*.mjs
!scripts/*.js
# Phase 13 operational tooling. These are maintained, reviewed shell scripts
# that read every credential from the environment and never hold one — the
# exact opposite of the one-shot rotation scripts the rule above blocks.
!scripts/backup-production.sh
!scripts/restore-drill.sh
# One-shot state files created during operator flows — pattern lets them
# stay local without accidentally being staged.
.env.mint-token-oneshot
.probe-super-creds.json
FIX_CRONS.md
VERCEL_SETUP.md
